# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- Database ---------------------------------------------------------------
# SQLite (default, personal scale). Path is relative to the backend/ directory.
DATABASE_URL=sqlite+aiosqlite:///./jobs.db
# Postgres later — the models are dialect-neutral, so this is the only change:
# DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobs

# --- Ingestion --------------------------------------------------------------
COMPANIES_FILE=./companies.yaml
# Eligibility + currency rules applied between normalize and persist.
FILTERS_FILE=./config/filters.yaml
INGEST_INTERVAL_MINUTES=60
RUN_SCHEDULER=true
INGEST_CONCURRENCY=5
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2
# HTTP 429 gets its own budget so a rate limit (Himalayas) does not burn the
# retry allowance reserved for real errors. Backoff is exponential from the
# base delay, or whatever `Retry-After` asks for.
RATE_LIMIT_MAX_RETRIES=4
RATE_LIMIT_BASE_DELAY_SECONDS=1.0
# Hard cap on pages walked per aggregator query. Himalayas' `totalCount` does
# not match what it will actually page out, so paging stops on an empty page
# and this bounds a runaway sweep.
AGGREGATOR_MAX_PAGES=25
# Refuse to mass-close a board that returned zero jobs (protects against a
# typo'd Ashby slug, which answers HTTP 200 with an empty list).
GUARD_EMPTY_FETCHES=true

# --- Telegram alerts --------------------------------------------------------
# Create a bot with @BotFather; get the chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATIONS_ENABLED=true
MAX_NOTIFICATIONS_PER_RUN=25

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
