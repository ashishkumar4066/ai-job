# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- Database ---------------------------------------------------------------
# SQLite (default, personal scale). Path is relative to the backend/ directory.
DATABASE_URL=sqlite+aiosqlite:///./jobs.db
# Postgres later — the models are dialect-neutral, so this is the only change:
# DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobs

# --- Ingestion --------------------------------------------------------------
COMPANIES_FILE=./companies.yaml
INGEST_INTERVAL_MINUTES=60
RUN_SCHEDULER=true
INGEST_CONCURRENCY=5
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2
# Refuse to mass-close a board that returned zero jobs (protects against a
# typo'd Ashby slug, which answers HTTP 200 with an empty list).
GUARD_EMPTY_FETCHES=true

# --- Telegram alerts --------------------------------------------------------
# Create a bot with @BotFather; get the chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATIONS_ENABLED=true
MAX_NOTIFICATIONS_PER_RUN=25

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
