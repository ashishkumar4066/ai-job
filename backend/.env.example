# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- Database ---------------------------------------------------------------
# SQLite (default, personal scale). Path is relative to the backend/ directory.
DATABASE_URL=sqlite+aiosqlite:///./jobs.db
# Postgres later — the models are dialect-neutral, so this is the only change:
# DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobs

# --- Ingestion --------------------------------------------------------------
COMPANIES_FILE=./companies.yaml
# Eligibility + currency rules applied between normalize and persist.
FILTERS_FILE=./config/filters.yaml
# How often the scheduler CHECKS whether a sweep is due — not how often it
# sweeps. A check is one SQL query; it only fetches when REFRESH_WINDOW_HOURS
# has lapsed. Checking hourly is what lets a failed daily sweep retry soon
# instead of waiting another full day.
INGEST_INTERVAL_MINUTES=60
# The rolling freshness window. Boards are contacted at most once per this many
# hours, by the scheduler and by the dashboard alike. Rolling, not a calendar
# day: a sweep at 23:00 is still fresh at 00:05. Only the manual refresh button
# (force=true) sweeps inside the window.
REFRESH_WINDOW_HOURS=24
RUN_SCHEDULER=true
INGEST_CONCURRENCY=5
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2
# HTTP 429 gets its own budget so a rate limit (Himalayas, Firecrawl) does not
# burn the retry allowance reserved for real errors. Backoff is exponential from
# the base delay, or whatever `Retry-After` asks for.
# Keep this high enough to outlast a per-minute limit window: 7 doublings from
# 1s is ~127s. At 4 it gave up after ~15s and failed Wellfound on every run.
RATE_LIMIT_MAX_RETRIES=6
RATE_LIMIT_BASE_DELAY_SECONDS=1.0
# Ceiling on any single backoff sleep, so a throttled source cannot stall a
# run for an hour on the tail of an exponential ladder.
RATE_LIMIT_MAX_DELAY_SECONDS=32
# Hard cap on pages walked per aggregator query. Himalayas' `totalCount` does
# not match what it will actually page out, so paging stops on an empty page
# and this bounds a runaway sweep.
AGGREGATOR_MAX_PAGES=25
# Refuse to mass-close a board that returned zero jobs (protects against a
# typo'd Ashby slug, which answers HTTP 200 with an empty list).
GUARD_EMPTY_FETCHES=true

# --- Wellfound / Firecrawl --------------------------------------------------
# Wellfound has no public API and blocks plain HTTP clients, so its adapter
# renders pages through Firecrawl (https://firecrawl.dev). Without a key the
# source is skipped and every other adapter keeps working.
FIRECRAWL_API_KEY=
# 0 forces a live render. Raise it to let Firecrawl serve a recent copy, which
# is cheaper and much easier on the rate limit.
FIRECRAWL_MAX_AGE_MS=0
# Firecrawl caps requests per minute and does NOT send a `Retry-After`
# header, so the adapter paces its own calls instead of discovering the
# limit the hard way. Measured ceiling on the current plan: 16/min.
FIRECRAWL_REQUESTS_PER_MINUTE=15
# Pages per query — each one is a browser render, and this multiplies by the
# number of `queries` on the Wellfound entry in companies.yaml. 8 queries x 10
# pages was 80 back-to-back renders, which tripped the rate limit outright.
WELLFOUND_MAX_PAGES=3
# Stage 2 re-reads each job's detail page to confirm candidate eligibility;
# Wellfound renders an empty restriction list as "Everywhere" even for US-only
# roles. Turning it off is cheaper but lets that claim through unchecked.
WELLFOUND_VERIFY_DETAILS=true
# Ceiling on stage-2 detail renders per run — one Firecrawl credit each.
WELLFOUND_DETAIL_BUDGET=30

# --- Telegram alerts --------------------------------------------------------
# Create a bot with @BotFather; get the chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATIONS_ENABLED=true
MAX_NOTIFICATIONS_PER_RUN=25

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
