# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- Database ---------------------------------------------------------------
# SQLite (default, personal scale). Path is relative to the backend/ directory.
DATABASE_URL=sqlite+aiosqlite:///./jobs.db
# Postgres later — the models are dialect-neutral, so this is the only change:
# DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobs

# --- Ingestion --------------------------------------------------------------
COMPANIES_FILE=./companies.yaml
# Eligibility + currency rules applied between normalize and persist.
FILTERS_FILE=./config/filters.yaml
# How often the scheduler CHECKS whether a sweep is due — not how often it
# sweeps. A check is one SQL query; it only fetches when REFRESH_WINDOW_HOURS
# has lapsed. Checking hourly is what lets a failed daily sweep retry soon
# instead of waiting another full day.
INGEST_INTERVAL_MINUTES=60
# The rolling freshness window. Boards are contacted at most once per this many
# hours, by the scheduler and by the dashboard alike. Rolling, not a calendar
# day: a sweep at 23:00 is still fresh at 00:05. Only the manual refresh button
# (force=true) sweeps inside the window.
REFRESH_WINDOW_HOURS=24
RUN_SCHEDULER=true
INGEST_CONCURRENCY=5
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=2
# HTTP 429 gets its own budget so a rate limit (Himalayas, Firecrawl) does not
# burn the retry allowance reserved for real errors. Backoff is exponential from
# the base delay, or whatever `Retry-After` asks for.
# Keep this high enough to outlast a per-minute limit window: 7 doublings from
# 1s is ~127s. At 4 it gave up after ~15s and failed Wellfound on every run.
RATE_LIMIT_MAX_RETRIES=6
RATE_LIMIT_BASE_DELAY_SECONDS=1.0
# Ceiling on any single backoff sleep, so a throttled source cannot stall a
# run for an hour on the tail of an exponential ladder.
RATE_LIMIT_MAX_DELAY_SECONDS=32
# Hard cap on pages walked per aggregator query. Himalayas' `totalCount` does
# not match what it will actually page out, so paging stops on an empty page
# and this bounds a runaway sweep.
AGGREGATOR_MAX_PAGES=25
# Refuse to mass-close a board that returned zero jobs (protects against a
# typo'd Ashby slug, which answers HTTP 200 with an empty list).
GUARD_EMPTY_FETCHES=true

# --- Wellfound / Firecrawl --------------------------------------------------
# Wellfound has no public API and blocks plain HTTP clients, so its adapter
# renders pages through Firecrawl (https://firecrawl.dev). Without a key the
# source is skipped and every other adapter keeps working.
FIRECRAWL_API_KEY=
# 0 forces a live render. Raise it to let Firecrawl serve a recent copy, which
# is cheaper and much easier on the rate limit.
FIRECRAWL_MAX_AGE_MS=0
# Firecrawl caps requests per minute and does NOT send a `Retry-After`
# header, so the adapter paces its own calls instead of discovering the
# limit the hard way. Measured ceiling on the current plan: 16/min.
FIRECRAWL_REQUESTS_PER_MINUTE=15
# Pages per query — each one is a browser render, and this multiplies by the
# number of `queries` on the Wellfound entry in companies.yaml. 8 queries x 10
# pages was 80 back-to-back renders, which tripped the rate limit outright.
WELLFOUND_MAX_PAGES=3
# Stage 2 re-reads each job's detail page to confirm candidate eligibility;
# Wellfound renders an empty restriction list as "Everywhere" even for US-only
# roles. Turning it off is cheaper but lets that claim through unchecked.
WELLFOUND_VERIFY_DETAILS=true
# Ceiling on stage-2 detail renders per run — one Firecrawl credit each.
WELLFOUND_DETAIL_BUDGET=30

# --- LLM deep read ------------------------------------------------------------
# Powers `scripts.run_llm_screen` and POST /matches/llm. Without a key for the
# selected provider the deep read is skipped; the deterministic ranking works.
#
# Which provider the deep read uses: groq | mistral | cerebras. Cached verdicts
# survive a switch (each records `provider` and `model`); only unread rows go to
# the new provider.
LLM_PROVIDER=cerebras

# --- Groq ---
GROQ_API_KEY=
# Measured, not chosen on specs: qwen held the strict schema on every attempt
# at ~1,800 tokens a row, while gpt-oss-120b violated it intermittently at
# ~3,100 and gpt-oss-20b cannot hold it at all. See CLAUDE.md.
GROQ_MODEL=qwen/qwen3.8-27b
# Only sent to the gpt-oss family, which accepts it; `low` matched `medium`'s
# verdict for 22% fewer tokens.
GROQ_REASONING_EFFORT=low
# Free plan, per model (https://console.groq.com/docs/rate-limits). Tokens per
# DAY is the one that ends a pass: ~110 rows.
GROQ_REQUESTS_PER_MINUTE=30
GROQ_REQUESTS_PER_DAY=1000
GROQ_TOKENS_PER_MINUTE=8000
GROQ_TOKENS_PER_DAY=200000

# --- Mistral ---
# Studio → API Keys → Create new key. Free mode needs no card.
# https://docs.mistral.ai/getting-started/quickstarts/studio/activate-and-generate-api-key
MISTRAL_API_KEY=
# The quickstart's model. Not yet probed against this board the way qwen was.
MISTRAL_MODEL=mistral-small-latest
# Mistral limits per SECOND, per minute and per MONTH, per organization, and
# publishes free-mode numbers only on Admin → Limits
# (https://admin.mistral.ai/plateforme/limits). Set these to what it shows.
MISTRAL_REQUESTS_PER_SECOND=1
MISTRAL_TOKENS_PER_MINUTE=500000
MISTRAL_TOKENS_PER_MONTH=1000000000

# --- Cerebras ---
# cloud.cerebras.ai → API Keys. https://inference-docs.cerebras.ai
CEREBRAS_API_KEY=
# Public structured-output models: qwen-3.8-27b | gpt-oss-120b. Not yet probed
# against this board on Cerebras.
CEREBRAS_MODEL=qwen-3.8-27b
# qwen: none|low|medium|high, defaults to HIGH if omitted (long, billed traces).
# gpt-oss-120b: low|medium|high. `low` is valid for both; empty omits it.
CEREBRAS_REASONING_EFFORT=low
# Cerebras books each call as prompt + this against its token limits, and
# reasoning counts toward it. A row failing "truncated at max_completion_tokens"
# means raise this.
CEREBRAS_MAX_COMPLETION_TOKENS=4096
# Per MODEL — these are qwen-3.8-27b's. Minute figures are the Developer tier
# (https://inference-docs.cerebras.ai/models/qwen-3.8-27b); hour/day are what
# the key reports in its x-ratelimit-* headers. Token limits are the UNCACHED
# bucket (total is 3x). The headers are also read on every call, so a key on a
# lower tier is still paced correctly. Free Trial: 5 req/min, 30K tok/min, 1M/day.
CEREBRAS_REQUESTS_PER_MINUTE=300
CEREBRAS_REQUESTS_PER_HOUR=27000
CEREBRAS_REQUESTS_PER_DAY=648000
CEREBRAS_TOKENS_PER_MINUTE=150000
CEREBRAS_TOKENS_PER_HOUR=9000000
CEREBRAS_TOKENS_PER_DAY=216000000

# --- Shared by every provider (the old GROQ_* names still work) ---
LLM_BUDGET_HEADROOM=0.9
# Default jobs read per pass (the dashboard offers 10/15/20/50). Anything above
# 50 is clamped to 50 — the LLM shortlist never reads more in one pass.
LLM_MAX_REQUESTS_PER_RUN=15
# Exponential backoff for 429s without a named wait, 5xx and network errors.
LLM_BACKOFF_BASE_SECONDS=2
LLM_BACKOFF_MAX_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_RATE_LIMIT_RETRIES=8
# A named wait longer than this is a daily/monthly cap: the pass stops cleanly.
LLM_MAX_WAIT_SECONDS=300

# --- Telegram alerts --------------------------------------------------------
# Create a bot with @BotFather; get the chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATIONS_ENABLED=true
MAX_NOTIFICATIONS_PER_RUN=25

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
