# Loaded only by `--mode demo` (npm run dev:demo / build:demo). A normal
# `npm run dev` or `npm run build` never reads this file, so the demo layer
# stays switched off for local work against the real backend.

# Turns on the fetch shim in src/demo/. This is the whole switch.
VITE_DEMO_JOB=1

# The waitlist target — a Google Apps Script web-app URL. Left blank here on
# purpose: set it in the Vercel project's environment variables so rotating it
# does not need a commit. With it unset the form says it is not wired up rather
# than silently dropping addresses.
VITE_WAITLIST_URL=https://script.google.com/macros/s/AKfycbwNziQAUg2JL1nNetn1uH81WGV2N0Jywd9cZ5cfCppvoDw4okXgOgZJ5vLdpJKLyRp_/exec
